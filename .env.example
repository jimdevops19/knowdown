# Knowdown backend configuration (12-factor).
#
# Copy to .env at the repo root; base.py loads it if present. Nothing here is
# required — with no .env the backend runs zero-config against local sqlite
# (backend/db.sqlite3) with the in-memory channel layer and cache.

# Which settings module manage.py / asgi / wsgi use. Default: config.settings.local
# DJANGO_SETTINGS_MODULE=config.settings.local

SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL in any real deployment; omitted, it falls back to sqlite.
# DATABASE_URL=postgres://knowdown:knowdown@localhost:5432/knowdown

# Redis. Carries the matchmaking pool and the live match state once
# apps/matches exists; without it the channel layer is per-process (fine for
# runserver and the test suite, wrong for anything with more than one worker).
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_URL=redis://localhost:6379/1

# Django admin — off unless asked for, and never at /admin/. With ADMIN_URL
# unset a random 40-character prefix is generated per process and printed by
# `manage.py runserver`.
# ADMIN_ENABLED=true
# ADMIN_URL=some-long-unguessable-prefix

# The admin's own door (apps/ops). Off in dev — the mounted ADMIN_URL prefix
# is reachable directly there. On in production by default: the mounted
# prefix 404s from outside and the admin answers only under a token minted by
# `manage.py open_admin --minutes 30`, stored hashed, closed by `close_admin`
# or its own clock. See backend/apps/ops for the whole mechanism.
# ADMIN_GATE_ENABLED=true

# Where uploads are written. Defaults to backend/media locally (correct for
# dev, wrong for a container with a read-only code dir) and to /data/media
# under config.settings.production — the volume backend/Dockerfile already
# creates — so a deployment need not set this unless pointing MEDIA_ROOT
# somewhere else on purpose (object storage mounted as a filesystem, say).
# MEDIA_ROOT=/data/media

# CORS origins for the SPA, once there is one.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# LOG_LEVEL=INFO
# LOG_TO_FILE=false

# --- Identity ---------------------------------------------------------------

# Where a password-reset link points. The client's own origin, never derived
# from the request that asked for the link.
# FRONTEND_URL=http://localhost:5173

# Whether this tier offers an email/password door at all. Off, it unmounts
# /auth/token/, /auth/registration/ and both password-reset routes, and
# GET /auth/config/ says so to the client.
# PERMIT_PASSWORD_AUTH=true

# Access/refresh token lifetimes. The refresh token rides an HttpOnly cookie
# scoped to /api/v1/auth/; the access token is short-lived and memory-only.
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=7

# Google sign-in. With either of these unset the provider is left
# *unconfigured* rather than registered with empty strings, and /auth/config/
# reports google_enabled=false. Register an OAuth 2.0 Web application in a
# Google Cloud project to get them.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Sign-in lockout (apps/accounts/services/lockout.py). Counted per address
# *typed*, hashed into the cache key. Enforcement off = counting only.
# LOGIN_LOCKOUT_ENFORCED=true
# LOGIN_FAILURE_WINDOW_SECONDS=900
# LOGIN_DELAY_AFTER=3
# LOGIN_DELAY_CAP_SECONDS=60
# LOGIN_LOCKOUT_AFTER=10
# LOGIN_LOCKOUT_SECONDS=900
# Dangerous to turn on where every request arrives with the same forwarded
# address: an IP lock there locks out everybody at once.
# LOGIN_LOCKOUT_BY_IP=false

# Per-scope throttles for the doors that cost something.
# THROTTLE_LOGIN=10/min
# THROTTLE_PASSWORD_RESET=5/min

# CPU (bot) opponents (apps/matches/bots/). Off in every tier by default;
# local.py hardcodes it on regardless of this var, since a solo dev has nobody
# else to be matched against. Run `manage.py seed_bots` once to populate the
# 50-bot roster this pairs against.
# FF_ENABLE_BOTS_IF_TIMEOUT=false
# MATCHMAKING_BOT_TIMEOUT_SECONDS=8

# Match abuse limits (apps/matches/abuse.py) — answering, joining the
# matchmaking pool, and how many sockets one account may hold open at once.
# Enforcement off = counting only, the same trade as the lockout above.
# MATCH_ABUSE_LIMITS_ENFORCED=true
# ANSWER_SUBMIT_RATE_LIMIT=20
# ANSWER_SUBMIT_RATE_WINDOW_SECONDS=60
# MATCHMAKING_JOIN_RATE_LIMIT=10
# MATCHMAKING_JOIN_RATE_WINDOW_SECONDS=60
# MAX_CONCURRENT_SOCKETS_PER_PLAYER=4
# CONCURRENT_SOCKET_TTL_SECONDS=21600

# Outbound mail — today only the password-reset link. Unset in local dev and
# the test suite, which print/collect the message instead of sending it.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=no-reply@knowdown.app
