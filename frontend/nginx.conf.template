# Rendered to /etc/nginx/conf.d/default.conf at container start (envsubst
# substitutes ${BACKEND_URL}/${REALTIME_URL}/${NGINX_LOCAL_RESOLVERS}). Serves
# the built SPA and proxies /api, /ws and /media to Django — modeled on
# rpool's frontend/nginx.conf.template, trimmed to what knowdown actually has
# (no PWA service worker today).

# TLS is terminated at the ingress, which then speaks PLAIN HTTP to this pod —
# so `$scheme` here is always "http", even for a request the browser made over
# HTTPS. Forwarding `$scheme` blindly tells Django every request is insecure:
# `request.is_secure()` is permanently False, which under
# config.settings.production (SECURE_SSL_REDIRECT on) is an infinite redirect
# loop — Django redirects to HTTPS, the ingress terminates it and forwards
# HTTP again, forever.
#
# So: pass through the ingress's X-Forwarded-Proto when there is one, and fall
# back to $scheme only for a direct hit (a port-forward, a probe). Trusting the
# inbound header is safe *because* this Service is ClusterIP — nothing outside
# the cluster can reach it to forge one.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (defense in depth; TLS/HSTS is terminated at the ingress).
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # CSP. script-src has no 'unsafe-inline'/'unsafe-eval' — the SPA is a plain
    # Vite bundle with no inline <script>. style-src keeps 'unsafe-inline'
    # because React's `style={{...}}` compiles to inline style attributes.
    # accounts.google.com is the Google Identity Services script the Google
    # sign-in button loads (see frontend/src/features/auth); nothing else here
    # is cross-origin — /api, /media and /ws are same-origin via the proxies
    # below.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://accounts.google.com https://www.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # Same-origin API proxy -> backend Service. Keeps browser calls same-origin
    # (no CORS) exactly like the Vite dev proxy in vite.config.ts.
    #
    # ${BACKEND_URL}/${NGINX_LOCAL_RESOLVERS} are envsubst'd at container start;
    # $upstream/$request_uri/$host are nginx runtime vars (left untouched). A
    # variable in proxy_pass forces DNS resolution PER REQUEST via the cluster
    # resolver, so nginx boots even if the backend isn't up yet.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream "${BACKEND_URL}";
        proxy_pass $upstream$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Question images (and, later, player avatars). Backend URLs are
    # root-relative (MEDIA_URL = "media/"), so this same-origin proxy is what
    # resolves them.
    location /media/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream "${BACKEND_URL}";
        proxy_pass $upstream$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # WebSockets -> the realtime Service (uvicorn/ASGI), a *different* upstream
    # from /api/ above (gunicorn/WSGI) — see backend/config/asgi.py. Same
    # origin as the page, so the socket needs no CORS and no second hostname.
    #
    # Three settings here are not optional:
    #   - Upgrade/Connection: without them nginx speaks HTTP/1.0 to the
    #     upstream and the handshake never becomes a socket.
    #   - proxy_buffering off: nginx would otherwise hold pushed frames in a
    #     buffer waiting for it to fill, so updates arrive in bursts.
    #   - proxy_read_timeout: the default 60s closes any socket on a match
    #     where nothing happened for a minute.
    location /ws/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $ws_upstream "${REALTIME_URL}";
        proxy_pass $ws_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header Origin            $http_origin;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── PWA ───────────────────────────────────────────────────────────────
    # The service worker must never be served stale: a cached sw.js pins the
    # whole app to the build it shipped with, and no deploy can dislodge it.
    location = /sw.js {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }
    # nginx's default mime.types has no entry for .webmanifest, and a manifest
    # served as text/plain is a manifest Chrome ignores — no install prompt.
    location = /manifest.webmanifest {
        types { } default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Long-cache fingerprinted build assets.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA history-mode fallback: unknown routes serve index.html — which is
    # revalidated every time, so a new deploy is picked up on the next load
    # rather than whenever the browser feels like it.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
