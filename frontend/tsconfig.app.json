{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* vite-plugin-pwa/react declares the `virtual:pwa-register/react` module the
       update prompt imports; without it that import has no types at all. */
    "types": ["vite/client", "vite-plugin-pwa/react"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* sw.ts belongs to tsconfig.worker.json — it is typed against WebWorker,
     not DOM, and would not compile here. */
  "exclude": ["src/sw.ts"]
}
